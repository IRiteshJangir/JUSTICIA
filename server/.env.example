# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URL (replace with your MongoDB Atlas cluster URI)
# Example: mongodb+srv://admin:YourPassword@cluster0.abcde.mongodb.net/justicia?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/justicia?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-with-random-64-character-string
JWT_EXPIRES_IN=30d

# Frontend Client URL (your Vercel live URL)
# Example: https://justicia-advocates.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Optional Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Nodemailer (for email notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM_EMAIL=noreply@justicia.com
SMTP_FROM_NAME=JUSTICIA Consultancy

# Optional Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
